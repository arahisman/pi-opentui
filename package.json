{
  "name": "pi-opentui",
  "version": "0.1.0-alpha.1",
  "description": "An experimental OpenTUI terminal interface for Pi with session navigation, model usage and optional advisor integration",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pi-opentui": "bin/pi-opentui.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "capture": "bun scripts/capture-ui.ts",
    "verify:package": "bun scripts/verify-package.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@opentui/core": "0.8.4",
    "bun": "1.4.4",
    "@earendil-works/pi-ai": "1.5.2",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arahisman/pi-opentui.git"
  },
  "homepage": "https://github.com/arahisman/pi-opentui#readme",
  "bugs": {
    "url": "https://github.com/arahisman/pi-opentui/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "opentui",
    "tui",
    "coding-agent"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
